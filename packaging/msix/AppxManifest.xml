<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest des Store-Pakets (MSIX). scripts/New-StorePackage.ps1 setzt die
  Werte in {{…}} ein: Name und Herausgeber aus dem Partner Center, die
  Version aus Cargo.toml.

  Warum `unvirtualizedResources`: Eine MSIX-App legt neue Dateien unter
  AppData sonst in einem privaten Ordner ab. Photoshop und Lightroom sähen
  importierte Presets dann nicht, und „Ordner öffnen“ zeigte leere Ordner.
  Nur die drei Ordner unten schreiben echt (ExcludedDirectory); alles andere
  unter AppData bleibt umgeleitet. Das gibt es erst ab Windows 11 – deshalb
  ist die Store-Fassung nur für Windows 11 (MinVersion 10.0.22000.0).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap rescap virtualization">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Preset Manager</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <!-- Presets und Profile von Camera Raw, Photoshop und Lightroom Classic -->
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\Adobe\CameraRaw</virtualization:ExcludedDirectory>
        <!-- Einstellungen der App -->
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\PresetManager</virtualization:ExcludedDirectory>
        <!-- Sicherungen, Protokoll für Rückgängig, Logdateien -->
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\PresetManager</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="de-DE" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="PresetManager" Executable="PresetManager.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Preset Manager"
        Description="Presets and profiles for Camera Raw, Photoshop and Lightroom Classic: import, sort, preview."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
